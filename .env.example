# LLM provider: "openai" (default) or "gemini"
LLM_PROVIDER=openai

# Used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# Used when LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Browser for createDriver()'s fresh-launch path: chrome (default), firefox, edge, or safari.
# Not used by scripts/run-exercise.js / run-iframe-exercise.js, which attach over CDP
# and are Chromium-only (chrome/brave/edge).
BROWSER=chrome
BROWSER_BINARY_PATH=

# Final-test auto-answering (read-only by default — see scripts/run-final-test.js):
# Set to 1 to click+save answers whose LLM confidence clears the threshold below.
# A Final Test has exactly ONE attempt — overconfident guesses cannot be undone.
# FINAL_TEST_AUTO_ANSWER=0
# FINAL_TEST_CONFIDENCE_THRESHOLD=0.9
# FINAL_TEST_REVIEWS_REQUIRED: minimum number of consecutive agreeing passes an
# answer needs before it can auto-click (default 1). E.g. 2 = the answer must
# survive a second independent re-derivation pass agreeing with it. Raise this
# for extra safety on a 1-attempt test.
# FINAL_TEST_REVIEWS_REQUIRED=1
# FINAL_TEST_GUESS_LISTENING: set to 1 to click a random letter on each
# listening question (and Save it) instead of skipping. Blank = 0 points;
# a random guess is ~25%/question — strictly better if you only need to clear
# the passing score (66). Guesses still land in the answer key for review.
# FINAL_TEST_GUESS_LISTENING=0
# Multi-pass review: each run also writes final-test-answers.json (with the
# test's URL id). A later run re-derives every question independently; answers
# that AGREE across passes get boosted confidence (auto-clickable), disagreements
# stay manual. A leftover json from a DIFFERENT test is auto-detected as stale
# and ignored — no need to delete it. Run the script 2-3x over the same test to
# drive confidence/agreement up before enabling auto-answer.
